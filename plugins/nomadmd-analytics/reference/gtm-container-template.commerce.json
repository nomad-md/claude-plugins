            "type": "TEMPLATE",
            "key": "javascript",
            "value": "function() {\n  var products = {{DLV - products}} || [];\n  return products.map(function(p) {\n    return {\n      item_id: String(p.product_id),\n      item_name: p.name,\n      item_category: p.category,\n      price: p.price,\n      quantity: p.quantity || 1\n    };\n  });\n}"
